# LLM backend for rag/rag_chain.py: "ollama" (local, default) or "gemini"
LLM_BACKEND=ollama

# Required only when LLM_BACKEND=gemini. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Optional, only used when LLM_BACKEND=ollama. Defaults to llama3.2:3b if unset.
OLLAMA_MODEL=llama3.2:3b
